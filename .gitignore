# Default deny: explicitly allow only reviewed publication files.
/*
!/.gitignore
!/README.md
!/REPORT.md
!/analysis/
/analysis/*
!/analysis/systemhelper.md
!/analysis/systemhelper_endpoints.md
!/analysis/apk_hashes.json
!/analysis/systemhelper_encryption_certificate.json
!/analysis/selected-evidence.md
!/disable-test/
/disable-test/*
!/disable-test/BASELINE.md
!/disable-test/RESULT.md
!/disable-test/ROLLBACK.md

# Individually reviewed, sanitized methodology scripts. Original collectors stay local.
!/scripts/
/scripts/*
!/scripts/adb_snapshot_public.py
!/scripts/apk_static_public.py
!/scripts/apk_urls_public.py
!/scripts/dex_evidence_public.py
!/scripts/netstats_summary_public.py
!/scripts/SCRIPT_REVIEW.md
!/disable-test/compare_snapshots_public.py
